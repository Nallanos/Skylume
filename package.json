    "@adonisjs/lucid": "^21.3.0",
    "@adonisjs/redis": "^9.1.0",
    "@adonisjs/session": "^7.5.0",
    "@adonisjs/shield": "^8.1.1",
    "@adonisjs/static": "^1.1.1",
    "@adonisjs/vite": "^3.0.0",
    "@atproto/api": "^0.13.12",
    "@floating-ui/dom": "^1.6.13",
    "@inertiajs/svelte": "^1.2.0",
    "@skyware/bot": "^0.3.8",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tailwindcss/forms": "^0.5.9",
    "@tensorflow-models/universal-sentence-encoder": "^1.3.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@types/chart.js": "^2.9.41",
    "@vinejs/vine": "^2.1.0",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^11.4.0",
    "bullmq": "^5.34.1",
    "chart.js": "^4.4.7",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dequal": "^2.0.3",
    "edge.js": "^6.2.0",
    "focus-trap": "^7.6.4",
    "graphile-worker": "^0.16.6",
    "lodash.clonedeep": "^4.5.0",
    "luxon": "^3.5.0",
    "nanoid": "^5.0.9",
    "p-queue": "^8.1.0",
    "p-retry": "^6.2.1",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.5",
    "pino": "^9.6.0",
    "pino-pretty": "^11.3.0",
    "postcss": "^8.4.47",
    "random-words": "^2.0.1",
    "reflect-metadata": "^0.2.2",
    "svelte": "^4.2.19",
    "svelte-preprocess": "^6.0.3",
    "tailwind-merge": "^2.5.4",
    "tailwind-variants": "^0.2.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "uuid": "^10.0.0",
    "vite": "^5.4.8",
    "ws": "^8.18.0"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "resolutions": {
    "strtok3": "8.0.1",
    "@japa/assert": "^2.0.0"
  },
  "overrides": {
    "strtok3": "8.0.1"
  },
  "pnpm": {
    "overrides": {
      "strtok3": "8.0.1"
    }
  },
  "prettier": "@adonisjs/prettier-config"
}
