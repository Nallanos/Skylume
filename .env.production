# Production Environment Configuration for Skynalytic

# Application
TZ=UTC
PORT=8081
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=production
SESSION_DRIVER=cookie
APP_URL=https://skylume.app

# Security - CHANGE THESE IN PRODUCTION
APP_KEY=PRODUCTION_SECURE_KEY_HERE
INTERNAL_API_KEY=PRODUCTION_INTERNAL_API_KEY_HERE

# Database - PostgreSQL
DB_HOST=postgresql
DB_PORT=5432
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_DATABASE=${POSTGRES_DB}

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
QUEUE_REDIS_HOST=redis
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=${REDIS_PASSWORD}

# Bluesky API
BLUESKY_IDENTIFIER=${BLUESKY_IDENTIFIER}
BLUESKY_PASSWORD=${BLUESKY_PASSWORD}

# Stripe Configuration - REGENERATE THESE KEYS
STRIPE_PUBLIC_KEY=${STRIPE_PUBLIC_KEY}
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
STRIPE_PRICE_ID=${STRIPE_PRICE_ID}
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_SECRET}

# Analysis Configuration
ANALYSIS_BATCH_SIZE=100
MAX_CONCURRENT_ANALYSES=5

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# Timeouts
HTTP_TIMEOUT=30000
API_RETRY_ATTEMPTS=3
