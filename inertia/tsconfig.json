{
  "extends": "@adonisjs/tsconfig/tsconfig.client.json",
  "compilerOptions": {
    "baseUrl": ".",
    "allowArbitraryExtensions": true,
    "module": "ESNext",
    "types": ["react", "react-dom"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",

    "paths": {
      "~/*": ["../*"],
      "@/*": ["./lib/*"]
    },
    "verbatimModuleSyntax": true
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../inertiajs-react.d.ts"]
}
