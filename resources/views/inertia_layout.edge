<!DOCTYPE html>
<html class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content="{{ csrfToken }}" />

    <title inertia>
      Skylume
    </title>

    <!-- Script pour appliquer le thème immédiatement et éviter le flash -->
    <script>
      // Récupérer le thème depuis localStorage ou utiliser les préférences système
      const storedTheme = localStorage.getItem("theme");
      
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      
      const theme = storedTheme || (prefersDark ? "dark" : "light");
      // Appliquer la classe au document html
      
      document.documentElement.className = theme;
      // Assurer que les textes sont toujours lisibles
      
      if (theme === "light") {
        document.documentElement.style.setProperty("--text-primary", "#111827"); // Plus foncé pour meilleure lisibilité
        document.documentElement.style.setProperty("--text-secondary", "#374151"); // Plus foncé pour meilleure lisibilité  
      }
    </script>

    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link
      href="https://fonts.bunny.net/css?family=instrument-sans:400,400i,500,500i,600,600i,700,700i"
      rel="stylesheet"
    />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-54JK6C7LJ7">
      
    </script>
    <script>
      window.dataLayer = window.dataLayer || [];
      
      function gtag() {
        dataLayer.push(arguments);
      }
      
      gtag("js", new Date());
      
      gtag("config", "G-54JK6C7LJ7");
    </script>

    @viteReactRefresh()
    @inertiaHead()
    @vite(['inertia/app/app.tsx', `inertia/pages/${page.component}.tsx`])
  </head>

  <body class="min-h-screen font-sans bg-background">
    @inertia()
  </body>

</html>
