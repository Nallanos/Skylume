<!DOCTYPE html>
<html class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title inertia>
      Bluesky-Bot
    </title>

    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link
      href="https://fonts.bunny.net/css?family=instrument-sans:400,400i,500,500i,600,600i,700,700i"
      rel="stylesheet"
    />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-54JK6C7LJ7">
      
    </script>
    <script>
      window.dataLayer = window.dataLayer || [];
      
      function gtag() {
        dataLayer.push(arguments);
      }
      
      gtag("js", new Date());
      
      gtag("config", "G-54JK6C7LJ7");
    </script>

    @inertiaHead()
    @vite(['inertia/app/app.ts', `inertia/pages/${page.component}.svelte`])
  </head>

  <body class="min-h-screen font-sans bg-background text-white">
    @inertia()
