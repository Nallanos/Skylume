# Configuration pour le service Python AI
# URL de l'API AdonisJS
ADONISJS_API_URL=http://localhost:8081

# Clé API pour authentifier les requêtes vers AdonisJS
INTERNAL_API_KEY=your-secret-api-key-here

# Configuration de logging
LOG_LEVEL=INFO

# Configuration du worker
POLLING_INTERVAL=10
MAX_RETRIES=3

