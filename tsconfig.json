{
  "extends": "@adonisjs/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./inertia/lib/*"]
    },
    "rootDir": "./",
    "outDir": "./build",
    "lib": ["ESNext", "DOM"],
    "typeRoots": ["./node_modules/@types", "./types"],
    "types": ["node"]
  },
  "include": ["**/*.ts", "types/**/*.d.ts"],
  "exclude": ["./inertia/**/*", "node_modules", "build"]
}
