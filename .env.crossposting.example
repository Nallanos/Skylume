# Crossposting Configuration
# Add these variables to your existing .env file

# ===========================================
# X (Twitter) API Configuration
# ===========================================
# Get these from https://developer.x.com/
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_CALLBACK_URL=http://localhost:3333/auth/twitter/callback

# ===========================================
# Meta Threads API Configuration  
# ===========================================
# Get these from https://developers.facebook.com/
THREADS_APP_ID=your_threads_app_id_here
THREADS_APP_SECRET=your_threads_app_secret_here
THREADS_CALLBACK_URL=http://localhost:3333/auth/threads/callback

# ===========================================
# Crossposting Settings
# ===========================================
# Enable/disable crossposting features
ENABLE_CROSSPOSTING=true

# Default platforms for new users (comma-separated)
DEFAULT_CROSSPOST_PLATFORMS=bluesky

# Rate limiting settings
CROSSPOST_RATE_LIMIT_WINDOW=900000  # 15 minutes in milliseconds
CROSSPOST_MAX_REQUESTS_PER_WINDOW=50

# Character limit overrides (optional)
TWITTER_CHAR_LIMIT=280
THREADS_CHAR_LIMIT=500
BLUESKY_CHAR_LIMIT=300
