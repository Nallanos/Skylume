TZ=UTC
PORT=8081
HOST=0.0.0.0
LOG_LEVEL=debug
APP_KEY=CHANGE_ME_generate_secure_32_char_key
NODE_ENV=development
SESSION_DRIVER=cookie
APP_URL=http://127.0.0.1:8081

# Base de données PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=blueskybluesky
DB_PASSWORD=blueskybluesky
DB_DATABASE=blueskybluesky

REDIS_PASSWORD= 
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Clé API pour l'authentification du service Python
INTERNAL_API_KEY=CHANGE_ME_generate_secure_api_key

# Configuration Bluesky API (à remplir avec vos credentials)
BLUESKY_IDENTIFIER=your_bluesky_identifier
BLUESKY_PASSWORD=your_bluesky_password

# Configuration OAuth pour Bluesky
BLUESKY_OAUTH_CLIENT_ID=your_oauth_client_id
BLUESKY_OAUTH_CLIENT_SECRET=your_oauth_client_secret
BLUESKY_OAUTH_REDIRECT_URI=http://127.0.0.1:8081/oauth/callback
BLUESKY_OAUTH_SCOPE=atproto transition:generic
BLUESKY_OAUTH_BASE_URL=https://bsky.social

# Configuration pour les analyses ML/AI
ANALYSIS_BATCH_SIZE=100
MAX_CONCURRENT_ANALYSES=5

# Configuration des limites de rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# Configuration des timeouts
HTTP_TIMEOUT=30000
API_RETRY_ATTEMPTS=3

# Configuration Stripe (REMPLACER PAR VOS VRAIES CLÉS)
STRIPE_PUBLIC_KEY=pk_test_CHANGE_ME_your_test_public_key
STRIPE_SECRET_KEY=sk_test_CHANGE_ME_your_test_secret_key
STRIPE_PRICE_ID=price_CHANGE_ME_your_price_id
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME_your_webhook_secret